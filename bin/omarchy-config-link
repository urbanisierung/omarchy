#!/bin/bash

# Link all the key config files to omarchy's internal versions for quicker testing
# Hyprland config migrated to Lua (hyprland.lua). To switch back to the classic
# hyprlang .conf, restore it with:
#   git mv config/hypr/hyprland.conf.bak config/hypr/hyprland.conf
# and re-point this symlink at hyprland.conf instead.
ln -nsf ~/.local/share/omarchy/config/hypr/hyprland.lua ~/.config/hypr/
ln -nsf ~/.local/share/omarchy/config/hypr/hypridle.conf ~/.config/hypr/
ln -nsf ~/.local/share/omarchy/config/waybar/config ~/.config/waybar/
ln -nsf ~/.local/share/omarchy/config/wofi/config ~/.config/wofi/
