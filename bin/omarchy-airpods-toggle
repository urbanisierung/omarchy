#!/usr/bin/env bash

# Toggle AirPods Pro connection for video calls. When connecting, switch the
# device to the headset profile (mic + audio) and make it the system-wide
# default sink and source, moving any active streams over to it.

set -euo pipefail

ENV_FILE="${HOME}/.config/envvars/mac.env"

if [ ! -f "$ENV_FILE" ]; then
    notify-send -u critical -i audio-headphones "AirPods Pro" "Missing $ENV_FILE"
    exit 1
fi

# shellcheck source=/dev/null
source "$ENV_FILE"

MAC="${AIRPODS:-}"

if [ -z "$MAC" ]; then
    notify-send -u critical -i audio-headphones "AirPods Pro" "AIRPODS not set in $ENV_FILE"
    exit 1
fi

# PipeWire/PulseAudio object names use the MAC with underscores instead of colons.
MAC_UNDERSCORE="${MAC//:/_}"
CARD="bluez_card.${MAC_UNDERSCORE}"

# Stashes the default sink/source that were active before the AirPods took over.
STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/omarchy-airpods-prev-defaults"

# Wait until an object whose name contains the given literal prefix appears in
# `pactl list short <kind>` and echo its name.
wait_for_object() {
    local kind="$1" prefix="$2" tries=0 name

    while [ "$tries" -lt 20 ]; do
        name=$(pactl list short "$kind" 2>/dev/null | awk -v p="$prefix" 'index($2, p) { print $2; exit }')
        if [ -n "$name" ]; then
            echo "$name"
            return 0
        fi
        sleep 0.5
        tries=$((tries + 1))
    done
    return 1
}

make_system_default() {
    # Remember the current defaults so they can be restored on disconnect.
    {
        echo "$(pactl get-default-sink 2>/dev/null)"
        echo "$(pactl get-default-source 2>/dev/null)"
    } > "$STATE_FILE"

    # Prefer the headset profile so the microphone is available for calls.
    pactl set-card-profile "$CARD" headset-head-unit >/dev/null 2>&1 || true

    local sink source
    sink=$(wait_for_object sinks "bluez_output.${MAC_UNDERSCORE}") || return 1
    source=$(wait_for_object sources "bluez_input.${MAC_UNDERSCORE}") || true

    pactl set-default-sink "$sink" >/dev/null 2>&1 || true
    # Move any currently playing streams onto the AirPods.
    pactl list short sink-inputs 2>/dev/null | while read -r id _; do
        pactl move-sink-input "$id" "$sink" >/dev/null 2>&1 || true
    done

    if [ -n "${source:-}" ]; then
        pactl set-default-source "$source" >/dev/null 2>&1 || true
        pactl list short source-outputs 2>/dev/null | while read -r id _; do
            pactl move-source-output "$id" "$source" >/dev/null 2>&1 || true
        done
    fi
}

restore_previous_default() {
    [ -f "$STATE_FILE" ] || return 0

    local sink source
    sink=$(sed -n '1p' "$STATE_FILE")
    source=$(sed -n '2p' "$STATE_FILE")
    rm -f "$STATE_FILE"

    # Only re-apply devices that still exist.
    if [ -n "$sink" ] && pactl list short sinks 2>/dev/null | grep -qw "$sink"; then
        pactl set-default-sink "$sink" >/dev/null 2>&1 || true
        pactl list short sink-inputs 2>/dev/null | while read -r id _; do
            pactl move-sink-input "$id" "$sink" >/dev/null 2>&1 || true
        done
    fi
    if [ -n "$source" ] && pactl list short sources 2>/dev/null | grep -qw "$source"; then
        pactl set-default-source "$source" >/dev/null 2>&1 || true
        pactl list short source-outputs 2>/dev/null | while read -r id _; do
            pactl move-source-output "$id" "$source" >/dev/null 2>&1 || true
        done
    fi
}

IS_CONNECTED=$(bluetoothctl info "$MAC" 2>/dev/null | grep "Connected: yes" || true)

if [ -n "$IS_CONNECTED" ]; then
    restore_previous_default
    bluetoothctl disconnect "$MAC" >/dev/null 2>&1 || true
    notify-send -u low -i audio-headphones "AirPods Pro" "Disconnected"
else
    # Ensure the bluetooth controller is powered on before connecting.
    bluetoothctl power on >/dev/null 2>&1 || true
    notify-send -u low -i audio-headphones "AirPods Pro" "Connecting..."

    # Give up if the connection isn't established within 5 seconds.
    if timeout 5 bluetoothctl connect "$MAC" 2>/dev/null | grep -q "Connection successful"; then
        if make_system_default; then
            notify-send -u normal -i audio-headphones "AirPods Pro" "Connected (audio + mic)"
        else
            notify-send -u normal -i audio-headphones "AirPods Pro" "Connected (audio routing failed)"
        fi
    else
        notify-send -u critical -i audio-headphones "AirPods Pro" "Connection Failed"
    fi
fi
