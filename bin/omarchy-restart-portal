#!/bin/bash

# Restart the desktop portals. Fixes black or frozen screen sharing (Zoom,
# Meet, OBS) and broken file pickers without logging out.
#
# Stops the GNOME/GTK portal backends that conflict with Hyprland's, then
# restarts xdg-desktop-portal-hyprland and xdg-desktop-portal.
#
#   omarchy-restart-portal          -> restart now and show a notification
#   omarchy-restart-portal --quiet  -> restart now, notify only on failure
#   omarchy-restart-portal --boot   -> for Hyprland autostart: wait for the
#                                      session, share its environment with
#                                      systemd/D-Bus, restart quietly (only
#                                      notifies on failure)

set -uo pipefail

quiet=0
[[ "${1:-}" == "--quiet" ]] && quiet=1
if [[ "${1:-}" == "--boot" ]]; then
  quiet=1
  sleep 2
  # Portals started by systemd need to know the Wayland display and desktop.
  dbus-update-activation-environment --systemd \
    WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP HYPRLAND_INSTANCE_SIGNATURE ||
    true
fi

for p in xdg-desktop-portal-gnome xdg-desktop-portal-gtk; do
  pkill -x "$p" 2>/dev/null || true
done

ok=1
systemctl --user restart xdg-desktop-portal-hyprland.service || ok=0
sleep 1
systemctl --user restart xdg-desktop-portal.service || ok=0

if ((ok)); then
  msg="Portals restarted. Start screen sharing again."
  urgency=normal
else
  msg="Portal restart failed. Check: journalctl --user -u xdg-desktop-portal-hyprland"
  urgency=critical
fi

if command -v notify-send >/dev/null && ! ((quiet && ok)); then
  notify-send -a "Screen sharing" -u "$urgency" "$msg"
fi
echo "$msg"
((ok))
