#!/bin/bash

# A script to display Hyprland keybindings defined in your configuration
# using wofi for an interactive search menu.

USER_HYPRLAND_CONF="$HOME/.config/hypr/hyprland.lua"
OMARCHY_BINDINGS_CONF="$HOME/.local/share/omarchy/default/hypr/bindings.lua"

# Process the configuration file to extract and format keybindings
# 1. `grep` finds all lines with an `hl.bind(...)` call.
# 2. `awk` does the heavy lifting of formatting the output:
#    - Drops a trailing `, { ... }` options table (e.g. submap/mouse flags).
#    - Pulls out the quoted key combo (first argument).
#    - Pulls out the dispatcher call (second argument) as the action text.
awk '
# Turn a raw dispatcher call (e.g. hl.dsp.exec_cmd("cmd")) into readable text.
function clean(a,    inner) {
    sub(/^hl\.dsp\./, "", a)
    if (a ~ /^exec_cmd\(/) {
        inner = substr(a, length("exec_cmd(") + 1)
        inner = substr(inner, 1, length(inner) - 1)
        if (inner ~ /^".*"$/) {
            inner = substr(inner, 2, length(inner) - 2)
        }
        a = inner
    }
    return a
}
{
    line = $0
    sub(/, \{[^}]*\}\)$/, ")", line)

    prefix = "hl.bind(\""
    p = index(line, prefix)
    if (p == 0) next
    rest = substr(line, p + length(prefix))

    q = index(rest, "\"")
    if (q == 0) next
    key_combo = substr(rest, 1, q - 1)
    gsub(/[ \t]+/, " ", key_combo)

    rest2 = substr(rest, q + 1)
    c = index(rest2, ",")
    if (c == 0) next
    action = substr(rest2, c + 1)
    gsub(/^[ \t]+/, "", action)
    if (substr(action, length(action), 1) == ")") {
        action = substr(action, 1, length(action) - 1)
    }

    action = clean(action)

    if (action != "" && action != "nil") {
        printf "%-35s → %s\n", key_combo, action
    }
}' "$USER_HYPRLAND_CONF" "$OMARCHY_BINDINGS_CONF" |
  flock --nonblock /tmp/.wofi.lock -c "wofi -dmenu -i --width 60% --height 70% -p 'Hyprland Keybindings' -O alphabetical"
