#!/usr/bin/env python3
"""Read-only Hyprland shortcut catalog; no configuration code is executed."""

import argparse
import importlib.util
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
spec = importlib.util.spec_from_file_location(
    "keybindings", ROOT / "tools/keybindings.py"
)
catalog = importlib.util.module_from_spec(spec)
spec.loader.exec_module(catalog)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--config", type=Path, action="append", help="Config root (repeatable)"
    )
    parser.add_argument(
        "--json", action="store_true", help="Print the catalog as JSON without a GUI"
    )
    parser.add_argument(
        "--export", type=Path, help="Write JSON without opening the GUI"
    )
    parser.add_argument(
        "--offline", action="store_true", help="Read files only; do not query Hyprland"
    )
    args = parser.parse_args()
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    configs = args.config or [config_home / "hypr/hyprland.lua"]
    if not args.config and not configs[0].exists():
        configs = [config_home / "hypr/hyprland.conf"]

    def load():
        return catalog.generate(configs, live=not args.offline)

    try:
        if args.json or args.export:
            data = load()
            if args.export:
                catalog.export_json(data, args.export)
            if args.json:
                print(json.dumps(data, ensure_ascii=False, indent=2))
            for warning in data["warnings"]:
                print(warning, file=sys.stderr)
        else:
            spec = importlib.util.spec_from_file_location(
                "keybindings_ui", ROOT / "tools/keybindings_ui.py"
            )
            ui = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(ui)
            ui.show(load, catalog.export_json)
    except (OSError, ValueError, ImportError) as error:
        print(f"Shortcut catalog: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
